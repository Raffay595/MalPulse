{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/health",            "dest": "/backend/app.py" },
    { "src": "/api/analyze",           "dest": "/backend/app.py" },
    { "src": "/api/analyze/batch",     "dest": "/backend/app.py" },
    { "src": "/api/pe",                "dest": "/backend/app.py" },
    { "src": "/api/pe/batch",          "dest": "/backend/app.py" },
    { "src": "/api/pdf",               "dest": "/backend/app.py" },
    { "src": "/api/pdf/batch",         "dest": "/backend/app.py" },
    { "src": "/api/chat/analyze",      "dest": "/backend/app.py" },
    { "src": "/api/chat/ask",          "dest": "/backend/app.py" },
    { "src": "/api/generate-report",   "dest": "/backend/app.py" },
    { "src": "/api/analyze-dynamic",   "dest": "/backend/app.py" },
    { "src": "/api/human-report",      "dest": "/backend/app.py" },
    { "src": "/api/supported-formats", "dest": "/backend/app.py" }
  ]
}
